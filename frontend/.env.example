# Local FastAPI Orchestrator Base URL (default: http://localhost:8000)
VITE_API_BASE_URL=http://localhost:8000

# Remote Google Colab GPU Engine ngrok Tunnel URL
# Copy the ngrok URL generated by running colab/IsaiCraft_GPU_Engine.ipynb
VITE_GPU_ENGINE_URL=https://your-colab-ngrok-subdomain.ngrok-free.dev

# Firebase Web App Client Configuration (Safe public client keys)
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id
