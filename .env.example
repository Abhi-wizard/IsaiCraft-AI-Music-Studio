# ===================================================
# IsaiCraft Root Environment Variables Template
# Copy this to backend/.env and frontend/.env as needed
# ===================================================

# --- Backend (FastAPI Orchestrator) ---
GEMINI_API_KEY=your_google_gemini_api_key_here
PORT=8000
FIREBASE_CREDENTIALS_PATH=firebase-adminsdk.json

# --- Remote GPU Engine (Google Colab & ngrok) ---
NGROK_AUTHTOKEN=your_ngrok_authtoken_here

# --- Frontend (Vite Client) ---
VITE_API_BASE_URL=http://localhost:8000
VITE_GPU_ENGINE_URL=https://your-colab-ngrok-subdomain.ngrok-free.dev

# --- Firebase Client Authentication ---
VITE_FIREBASE_API_KEY=your_firebase_client_api_key
VITE_FIREBASE_AUTH_DOMAIN=your-app.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-app.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id
