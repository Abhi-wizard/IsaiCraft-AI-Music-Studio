# ==========================================
# IsaiCraft Root .gitignore
# ==========================================

# Environment variables & credentials
.env
.env.*
!.env.example
*.env
firebase-adminsdk*.json
!firebase-adminsdk.example.json
google-services*.json
*.pem
*.key
*.token
*token.txt

# Node / Frontend dependencies & build output
node_modules/
dist/
build/
.npm/
.eslintcache

# Python virtual environments & bytecode
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
env.bak/
venv.bak/

# Jupyter & Google Colab
.ipynb_checkpoints/
*/.ipynb_checkpoints/*

# Audio recordings & large media
*.wav
*.mp3
*.flac
*.ogg
*.m4a
*.aac

# AI model weights & Hugging Face cache
models/
.cache/
huggingface/
checkpoints/

# IDE & Editor files
.vscode/
.idea/
*.swp
*.swo
*.sublime-project
*.sublime-workspace

# Operating System files
.DS_Store
Thumbs.db
Desktop.ini

# Logs & Temporary files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
tmp/
temp/
